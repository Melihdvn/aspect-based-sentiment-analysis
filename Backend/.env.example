PORT=3001
CORS_ORIGIN=*

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/ai_reviews?schema=public"

# Python NLP Service
NLP_SERVICE_URL="http://localhost:8000"

# LLM
GOOGLE_API_KEY=your-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_REVIEWS=120
GEMINI_MAX_CHARS=280

# Scraper
ENABLE_LIVE=0
SCRAPER_UA=Mozilla/5.0 (compatible; ABSA/1.0; +https://example.com/bot)
FETCH_TIMEOUT_MS=8000

# Playwright scraper
PLAYWRIGHT_HEADLESS=1
SCRAPER_TIMEOUT_MS=20000
SCRAPER_NAV_TIMEOUT_MS=15000
SCRAPER_SCROLL_STEPS=3
